{
  "name": "shader-park-core",
  "version": "0.2.8",
  "description": "core glsl and js framework for shader-park",
  "main": "dist/shader-park-core.esm.js",
  "cjs": "dist/shader-park-core.cjs.js",
  "module": "dist/shader-park-core.external.esm.js",
  "browser": "dist/shader-park-core.external.esm.js",
  "unpkg": "dist/shader-park-core.esm.js",
  "jsdelivr": "dist/shader-park-core.umd.js",
  "exports": {
    ".": {
      "import": "./dist/shader-park-core.external.esm.js",
      "require": "./dist/shader-park-core.external.cjs"
    },
    "./dist/shader-park-core.cjs.js": {
      "require": "./dist/shader-park-core.external.cjs",
      "default": "./dist/shader-park-core.cjs.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "p5": "dist/shader-park-p5.js",
  "TouchDesigner": "dist/shader-park-TouchDesigner.js",
  "minimalGLSLRendererESM": "dist/shader-park-minimal-renderer.esm.js",
  "minimalGLSLRendererCJS": "dist/shader-park-minimal-renderer.cjs.js",
  "bundle": "dist/shader-park-core.bundle.js",
  "private": false,
  "sideEffects": [
    "./glsl/bindings.js",
    "./glsl/glsl-lib.js",
    "./glsl/sdfs.js",
    "./generators/glslParser.js",
    "./generators/sculpt.js"
  ],
  "bin": {
    "toThreeJS": "converters/convertThreeJS.js",
    "toMinimal": "converters/convertMinimalRender.js"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "pretest": "npm run build",
    "prepublishOnly": "npm run build && npm run test",
    "test": "mocha --reporter spec test/render.js",
    "test:package": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && npm run build && node test/package.mjs",
    "test:examples": "node test/examples.mjs",
    "harness": "node test/harness/run.mjs",
    "corpus": "node test/harness/corpus.mjs",
    "inspect": "node test/harness/inspect.mjs",
    "toThreeJS": "node converters/convertThreeJS.js",
    "toOffline": "node converters/convertOfflineRenderer.js",
    "toMinimal": "node converters/convertMinimalRenderer.js",
    "toRawSDF4Meshing": "node converters/convertRawSDF4Meshing.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shader-park/shader-park-core.git"
  },
  "keywords": [
    "glsl",
    "sdf",
    "raymarching",
    "js",
    "signed",
    "distance",
    "field",
    "procedural",
    "modeling",
    "realtime",
    "graphics"
  ],
  "author": "Torin Blankensmith, Peter Whidden",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/shader-park/shader-park-core/issues"
  },
  "homepage": "https://github.com/shader-park/shader-park-core#readme",
  "dependencies": {
    "@rollup/plugin-babel": "^6.0.3",
    "@shaderfrog/glsl-parser": "^0.2.4",
    "acorn": "^8.18.0",
    "escodegen": "^2.1.0",
    "esprima": "^4.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.22.15",
    "@babel/preset-env": "^7.22.15",
    "@rollup/plugin-commonjs": "^25.0.4",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.2.1",
    "chai": "^4.3.8",
    "mocha": "^10.2.0",
    "p5": "^1.7.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.12.0",
    "rollup": "^3.28.1",
    "rollup-plugin-version-injector": "^1.3.3",
    "three": "0.155.0",
    "three-r125": "npm:three@0.125.0",
    "three-r186": "npm:three@0.186.1"
  },
  "peerDependencies": {
    "three": ">=0.125.0"
  }
}
